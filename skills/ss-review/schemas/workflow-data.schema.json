{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Named definitions are selected by WorkflowData.ps1. Required envelopes distinguish unfinished/missing work from deliberately empty results.",
  "$defs": {
    "inputHash": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
    "inputDiagnostics": {
      "type": "object", "additionalProperties": false, "required": ["schemaVersion", "counts"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "counts": {
          "type": "object", "additionalProperties": false,
          "required": ["setupCalls", "repeatedSetupCalls", "documentReadCalls", "firstReadFailures", "malformedQueryFailures", "cursorRestarts"],
          "properties": {
            "setupCalls": { "type": "integer", "minimum": 0 },
            "repeatedSetupCalls": { "type": "integer", "minimum": 0 },
            "documentReadCalls": { "type": "integer", "minimum": 0 },
            "firstReadFailures": { "type": "integer", "minimum": 0 },
            "malformedQueryFailures": { "type": "integer", "minimum": 0 },
            "cursorRestarts": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "sharedDocument": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "path", "sha256", "sizeBytes", "lineCount"],
      "properties": {
        "id": { "enum": ["prompt", "scope", "focusArea", "overview", "references", "workflowData", "queryRecipe"] },
        "path": { "$ref": "#/$defs/text" }, "sha256": { "$ref": "#/$defs/inputHash" },
        "sizeBytes": { "type": "integer", "minimum": 1 }, "lineCount": { "type": "integer", "minimum": 1 }
      }
    },
    "workerAssignment": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "phase", "resume", "diagnosticsPath", "contextPath", "documents"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "phase": { "enum": ["references", "fileGroups", "focusAreas", "overview", "review"] },
        "resume": { "type": "boolean" },
        "diagnosticsPath": { "$ref": "#/$defs/text" },
        "contextPath": { "type": ["string", "null"] },
        "documents": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sharedDocument" } }
      }
    },
    "sharedReadPage": {
      "type": "object", "additionalProperties": false,
      "required": ["documentId", "sha256", "contentOffset", "content", "contentLength", "nextOffset", "complete"],
      "properties": {
        "documentId": { "$ref": "#/$defs/text" }, "sha256": { "$ref": "#/$defs/inputHash" },
        "contentOffset": { "type": "integer", "minimum": 0 }, "content": { "type": "string", "minLength": 1 },
        "contentLength": { "type": "integer", "minimum": 1 },
        "nextOffset": { "type": ["integer", "null"], "minimum": 1 }, "complete": { "type": "boolean" }
      }
    },
    "queryOptions": {
      "type": "object", "additionalProperties": false,
      "required": ["query", "field", "files", "scope", "kind", "resolution", "threadId", "commentId", "authorship", "indexOnly", "text", "pageSize"],
      "properties": {
        "query": { "enum": ["metadata", "threads", "comments", "search", "changes"] },
        "field": { "type": "string" }, "files": { "type": "array", "items": { "$ref": "#/$defs/text" } },
        "scope": { "enum": ["all", "files", "global"] }, "kind": { "type": "string" },
        "resolution": { "type": "string" }, "threadId": { "type": "string" },
        "commentId": { "type": "string" }, "authorship": { "type": "string" },
        "indexOnly": { "type": "boolean" }, "text": { "type": "string" },
        "pageSize": { "type": "integer", "minimum": 1, "maximum": 50 }
      }
    },
    "queryPage": {
      "$comment": "Saved item shapes and content are validated by exact comparison with the canonical query projection before replay or continuation.",
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "query", "snapshotId", "totalCount", "items", "nextCursor", "complete"],
      "properties": {
        "schemaVersion": { "const": 1 }, "query": { "$ref": "#/$defs/text" },
        "snapshotId": { "$ref": "#/$defs/inputHash" }, "totalCount": { "type": "integer", "minimum": 0 },
        "items": { "type": "array", "maxItems": 50, "items": { "type": "object" } },
        "nextCursor": { "type": ["string", "null"] }, "complete": { "type": "boolean" }
      }
    },
    "queryRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "path", "comparePath", "snapshotId", "baselineId", "options", "requestId", "diagnosticsPath", "lastPage", "lastPageCursor"],
      "properties": {
        "schemaVersion": { "const": 1 }, "path": { "$ref": "#/$defs/text" },
        "comparePath": { "type": ["string", "null"] }, "snapshotId": { "$ref": "#/$defs/inputHash" },
        "baselineId": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/inputHash" }] }, "options": { "$ref": "#/$defs/queryOptions" },
        "requestId": { "$ref": "#/$defs/inputHash" }, "diagnosticsPath": { "$ref": "#/$defs/text" },
        "lastPage": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/queryPage" }] },
        "lastPageCursor": { "type": ["string", "null"], "pattern": "^([A-F0-9]{64}:[0-9]+:[0-9]+)?$" }
      },
      "allOf": [{
        "if": { "properties": { "lastPage": { "type": "null" } } },
        "then": { "properties": { "lastPageCursor": { "type": "null" } } },
        "else": { "properties": { "lastPageCursor": { "type": "string" } } }
      }]
    },
    "text": { "type": "string", "pattern": "\\S" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
    "inventoryEntry": {
      "type": "object", "additionalProperties": false, "required": ["path", "sizeBytes", "change"],
      "properties": {
        "path": { "$ref": "#/$defs/text" }, "sizeBytes": { "type": "integer", "minimum": 0 },
        "change": { "enum": ["new", "modified", "deleted"] }
      }
    },
    "inventory": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/inventoryEntry" } },
    "fileGroup": {
      "type": "object", "additionalProperties": false, "required": ["groupId", "files"],
      "properties": {
        "groupId": { "$ref": "#/$defs/id" },
        "files": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/inventoryEntry" } }
      }
    },
    "fileGroups": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/fileGroup" } },
    "span": {
      "type": "object", "additionalProperties": false,
      "required": ["root", "path", "startLine", "endLine"],
      "properties": {
        "root": { "enum": ["instruction-set-source", "instruction-set-raw"] },
        "path": { "$ref": "#/$defs/text" },
        "startLine": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 }
      }
    },
    "cluster": {
      "type": "object", "additionalProperties": false, "required": ["findingIds"],
      "properties": { "findingIds": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } } }
    },
    "findingIndexEntry": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "reviewerId", "focusArea", "title", "description", "recommendedAction", "anchorPath", "impactedPaths"],
      "properties": {
        "id": { "$ref": "#/$defs/text" }, "reviewerId": { "$ref": "#/$defs/id" },
        "focusArea": { "$ref": "#/$defs/text" }, "title": { "$ref": "#/$defs/text" },
        "description": { "$ref": "#/$defs/text" }, "recommendedAction": { "$ref": "#/$defs/text" },
        "anchorPath": { "$ref": "#/$defs/text" },
        "impactedPaths": { "type": "array", "items": { "$ref": "#/$defs/text" } },
        "followUpThreadId": { "$ref": "#/$defs/text" }
      }
    },
    "findingIndex": {
      "type": "object", "additionalProperties": false, "required": ["schemaVersion", "findings"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/findingIndexEntry" } }
      }
    },
    "merge": {
      "type": "object", "additionalProperties": false, "required": ["sourceFindingIds", "findingPath"],
      "properties": {
        "sourceFindingIds": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
        "findingPath": { "$ref": "#/$defs/text" }
      }
    },
    "update": {
      "type": "object", "additionalProperties": false, "required": ["findingId", "findingPath"],
      "properties": { "findingId": { "$ref": "#/$defs/text" }, "findingPath": { "$ref": "#/$defs/text" } }
    },
    "removal": {
      "type": "object", "additionalProperties": false, "required": ["findingId", "reason"],
      "properties": { "findingId": { "$ref": "#/$defs/text" }, "reason": { "$ref": "#/$defs/text" } }
    },
    "decision": {
      "type": "object", "additionalProperties": false, "required": ["findingId", "decision"],
      "properties": {
        "findingId": { "$ref": "#/$defs/text" },
        "decision": { "enum": ["approved", "rejected", "dropped", "auto-approved", "needs-audit"] },
        "reason": { "type": "string" }, "feedback": { "type": "string" }
      }
    },
    "mergeCandidates": {
      "type": "object", "additionalProperties": false, "required": ["schemaVersion", "clusters"],
      "properties": { "schemaVersion": { "const": 1 }, "clusters": { "type": "array", "items": { "$ref": "#/$defs/cluster" } } }
    },
    "mergePlan": {
      "type": "object", "additionalProperties": false, "required": ["schemaVersion", "groups"],
      "properties": { "schemaVersion": { "const": 1 }, "groups": { "type": "array", "items": { "$ref": "#/$defs/merge" } } }
    },
    "updates": {
      "type": "object", "additionalProperties": false, "required": ["schemaVersion", "updates"],
      "properties": { "schemaVersion": { "const": 1 }, "updates": { "type": "array", "items": { "$ref": "#/$defs/update" } } }
    },
    "removals": {
      "type": "object", "additionalProperties": false, "required": ["schemaVersion", "removals"],
      "properties": { "schemaVersion": { "const": 1 }, "removals": { "type": "array", "items": { "$ref": "#/$defs/removal" } } }
    },
    "decisions": {
      "type": "object", "additionalProperties": false, "required": ["schemaVersion", "decisions"],
      "properties": { "schemaVersion": { "const": 1 }, "decisions": { "type": "array", "items": { "$ref": "#/$defs/decision" } } }
    },
    "feedback": {
      "type": "object", "additionalProperties": false, "required": ["responseId", "findingId", "text"],
      "properties": {
        "responseId": { "$ref": "#/$defs/id" },
        "findingId": { "$ref": "#/$defs/text" },
        "text": { "$ref": "#/$defs/text" }
      }
    },
    "auditFeedback": {
      "type": "object", "additionalProperties": false, "required": ["schemaVersion", "feedback"],
      "properties": { "schemaVersion": { "const": 1 }, "feedback": { "type": "array", "items": { "$ref": "#/$defs/feedback" } } }
    },
    "mergeApproval": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "pullRequestUrl", "approveMerge", "approvedSourceCommit"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "pullRequestUrl": { "$ref": "#/$defs/text" },
        "approveMerge": { "type": "boolean" },
        "approvedSourceCommit": { "type": "string", "pattern": "^[0-9a-fA-F]{40,64}$" }
      }
    },
    "assessment": {
      "type": "object", "additionalProperties": false,
      "required": ["groupId", "path", "disposition", "scope", "reason"],
      "properties": {
        "groupId": { "$ref": "#/$defs/id" }, "path": { "$ref": "#/$defs/text" },
        "disposition": { "enum": ["reviewed", "excluded"] },
        "scope": { "type": "string" }, "reason": { "type": "string" }
      },
      "allOf": [{
        "if": { "properties": { "disposition": { "const": "excluded" } } },
        "then": { "properties": { "scope": { "$ref": "#/$defs/text" }, "reason": { "$ref": "#/$defs/text" } } }
      }]
    },
    "snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["inventorySha256", "fileGroupsSha256"],
      "properties": {
        "inventorySha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
        "fileGroupsSha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" }
      }
    },
    "coverageMeasurement": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "mode", "processLaunches", "journalWrites", "schemaValidationMilliseconds", "elapsedMilliseconds"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "mode": { "enum": ["PerFile", "Batch"] },
        "processLaunches": { "type": "integer", "minimum": 0 },
        "journalWrites": { "type": "integer", "minimum": 0 },
        "schemaValidationMilliseconds": { "type": "number", "minimum": 0 },
        "elapsedMilliseconds": { "type": "number", "minimum": 0 }
      }
    },
    "assessmentBatch": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "snapshot", "groupId", "assessments", "findingIds"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "snapshot": { "$ref": "#/$defs/snapshot" },
        "groupId": { "$ref": "#/$defs/id" },
        "assessments": { "type": "array", "items": { "$ref": "#/$defs/assessment" } },
        "findingIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/text" } }
      }
    },
    "batchReceipt": {
      "type": "object", "additionalProperties": false,
      "required": ["groupId", "sha256", "artifactPath", "findingIds"],
      "properties": {
        "groupId": { "$ref": "#/$defs/id" },
        "sha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
        "artifactPath": { "$ref": "#/$defs/text" },
        "findingIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/text" } }
      }
    },
    "reviewAssignment": {
      "type": "object", "additionalProperties": false,
      "required": ["reviewerId", "focusArea", "fileGroupQueuePath"],
      "properties": {
        "reviewerId": { "$ref": "#/$defs/id" },
        "focusArea": { "$ref": "#/$defs/text" },
        "fileGroupQueuePath": { "$ref": "#/$defs/text" },
        "dispatch": { "enum": ["review", "excluded"] },
        "focusAreaSha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
        "artifactPath": { "$ref": "#/$defs/text" }
      },
      "dependentRequired": {
        "dispatch": ["focusAreaSha256", "artifactPath"],
        "focusAreaSha256": ["dispatch", "artifactPath"],
        "artifactPath": ["dispatch", "focusAreaSha256"]
      }
    },
    "reviewWork": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "inventoryPath", "fileGroupsPath", "focusAreaQueuePath", "reviewers"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "inventoryPath": { "$ref": "#/$defs/text" },
        "fileGroupsPath": { "$ref": "#/$defs/text" },
        "focusAreaQueuePath": { "$ref": "#/$defs/text" },
        "reviewers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/reviewAssignment" } },
        "repositoryRoot": { "$ref": "#/$defs/text" },
        "snapshot": { "$ref": "#/$defs/snapshot" }
      },
      "dependentRequired": { "snapshot": ["repositoryRoot"], "repositoryRoot": ["snapshot"] }
    },
    "fileGroupJournal": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "kind", "items", "inProgress", "completedGroupIds", "assessments"],
      "properties": {
        "schemaVersion": { "const": 3 }, "kind": { "const": "fileGroups" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/fileGroup" } },
        "inProgress": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/fileGroup" }] },
        "completedGroupIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "assessments": { "type": "array", "items": { "$ref": "#/$defs/assessment" } },
        "snapshot": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/snapshot" }] },
        "failure": { "type": ["string", "null"], "pattern": "\\S" },
        "batchReceipts": { "type": "array", "items": { "$ref": "#/$defs/batchReceipt" } }
      }
    },
    "referrer": {
      "type": "object", "additionalProperties": false,
      "required": ["parentId", "source", "scope", "declarations"],
      "properties": {
        "parentId": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }] },
        "source": { "$ref": "#/$defs/span" },
        "scope": { "$ref": "#/$defs/text" },
        "declarations": { "type": "array", "items": { "$ref": "#/$defs/span" } }
      },
      "$comment": "Direct provenance binds to immutable materialized instructions; nested provenance binds to the parent's frozen expanded output.",
      "allOf": [{
        "if": { "properties": { "parentId": { "type": "null" } } },
        "then": { "properties": { "source": { "properties": { "root": { "const": "instruction-set-source" } } } } },
        "else": { "properties": { "source": { "properties": { "root": { "const": "instruction-set-raw" } } } } }
      }]
    },
    "referenceInput": {
      "type": "object", "additionalProperties": false, "required": ["id", "uri", "referrers"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "uri": { "$ref": "#/$defs/text" },
        "referrers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/referrer" } }
      }
    },
    "referenceResult": {
      "type": "object", "additionalProperties": false, "required": ["referenceId", "outputs", "error"],
      "properties": {
        "referenceId": { "$ref": "#/$defs/id" },
        "outputs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
        "error": { "type": ["string", "null"] }
      }
    },
    "reference": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "uri", "referrers", "state", "outputs", "error"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "uri": { "$ref": "#/$defs/text" },
        "referrers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/referrer" } },
        "state": { "enum": ["Pending", "Complete", "Failed"] },
        "outputs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
        "error": { "type": ["string", "null"] }
      },
      "allOf": [
        { "if": { "properties": { "state": { "const": "Pending" } } }, "then": { "properties": { "outputs": { "maxItems": 0 }, "error": { "type": "null" } } } },
        { "if": { "properties": { "state": { "const": "Complete" } } }, "then": { "properties": { "outputs": { "minItems": 1 }, "error": { "type": "null" } } } },
        { "if": { "properties": { "state": { "const": "Failed" } } }, "then": { "properties": { "outputs": { "maxItems": 0 }, "error": { "$ref": "#/$defs/text" } } } }
      ]
    },
    "expansion": {
      "type": "object", "additionalProperties": false, "required": ["schemaVersion", "state", "references"],
      "properties": {
        "schemaVersion": { "const": 1 }, "state": { "enum": ["Unknown", "Complete", "Degraded"] },
        "references": { "type": "array", "items": { "$ref": "#/$defs/reference" } }
      }
    }
  }
}
