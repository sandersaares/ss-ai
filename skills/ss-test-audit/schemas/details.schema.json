{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "auditId",
    "snapshotSha256",
    "contentSha256",
    "indexSha256",
    "toolVersion",
    "rubricVersion",
    "repositoryRevision",
    "repositoryRoot",
    "scopePaths",
    "assertionTrace",
    "testInventory",
    "diagnostics",
    "corrections",
    "consistencyDiagnostics"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "auditId": {
      "type": "string",
      "minLength": 1
    },
    "snapshotSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "contentSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "indexSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "toolVersion": {
      "type": "string",
      "minLength": 1
    },
    "rubricVersion": {
      "type": "string",
      "minLength": 1
    },
    "repositoryRevision": {
      "type": "string",
      "minLength": 1
    },
    "repositoryRoot": {
      "type": "string",
      "minLength": 1
    },
    "scopePaths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assertionTrace": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "testInventory": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "path",
          "detail"
        ]
      }
    },
    "corrections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "assertionId",
          "path",
          "line",
          "endLine",
          "column",
          "expression",
          "fileSha256",
          "reason"
        ]
      }
    },
    "consistencyDiagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "assertionIds",
          "detail"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "assertionIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^A[0-9]{6}$"
            }
          },
          "detail": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
