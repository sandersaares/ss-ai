{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "auditId",
    "snapshotSha256",
    "assertions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "auditId": {
      "type": "string",
      "minLength": 1
    },
    "snapshotSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 25,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assertionId",
          "classification",
          "evidenceStatus",
          "actualOutcome",
          "rationale",
          "citations",
          "callingTestIds"
        ],
        "properties": {
          "assertionId": {
            "type": "string",
            "pattern": "^A[0-9]{6}$"
          },
          "classification": {
            "enum": [
              "Documented",
              "Implicit",
              "Mixed",
              "Incidental"
            ]
          },
          "evidenceStatus": {
            "enum": [
              "Confirmed",
              "Ambiguous"
            ]
          },
          "actualOutcome": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "citations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "line",
                "excerpt"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                },
                "excerpt": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "incidentalReason": {
            "type": "string",
            "minLength": 1
          },
          "callingTestIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^T[0-9]{6}$"
            }
          },
          "unlinkedReason": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "classification": {
                  "const": "Documented"
                }
              },
              "required": [
                "classification"
              ]
            },
            "then": {
              "properties": {
                "evidenceStatus": {
                  "const": "Confirmed"
                },
                "citations": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "classification": {
                  "const": "Implicit"
                }
              },
              "required": [
                "classification"
              ]
            },
            "then": {
              "properties": {
                "evidenceStatus": {
                  "const": "Ambiguous"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "classification": {
                  "const": "Mixed"
                }
              },
              "required": [
                "classification"
              ]
            },
            "then": {
              "required": [
                "incidentalReason"
              ],
              "properties": {
                "evidenceStatus": {
                  "const": "Confirmed"
                },
                "citations": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "classification": {
                  "const": "Incidental"
                }
              },
              "required": [
                "classification"
              ]
            },
            "then": {
              "required": [
                "incidentalReason"
              ]
            }
          }
        ]
      }
    }
  }
}
