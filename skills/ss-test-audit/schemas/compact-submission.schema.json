{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "batchFingerprint",
    "rows"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "batchFingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 25,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/explicitJudgmentRow" },
          { "$ref": "#/$defs/reuseRow" }
        ]
      }
    }
  }
,
  "$defs": {
    "explicitJudgmentRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assertionId",
        "classification",
        "evidenceStatus",
        "actualOutcome",
        "rationale",
        "citationHandles",
        "callingTestIds"
      ],
      "properties": {
        "assertionId": {
          "type": "string",
          "pattern": "^A[0-9]{6}$"
        },
        "classification": {
          "enum": [
            "Documented",
            "Implicit",
            "Mixed",
            "Incidental"
          ]
        },
        "evidenceStatus": {
          "enum": [
            "Confirmed",
            "Ambiguous"
          ]
        },
        "actualOutcome": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "citationHandles": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^E[0-9a-f]{12}-[0-9]+$"
          }
        },
        "incidentalReason": {
          "type": "string",
          "minLength": 1
        },
        "callingTestIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^T[0-9]{6}$"
          }
        },
        "unlinkedReason": {
          "type": "string",
          "minLength": 1
        },
        "unresolvedCallerReason": {
          "type": "string",
          "minLength": 1
        },
        "reviewReason": {
          "type": "string",
          "minLength": 1
        },
        "decisiveClause": {
          "type": "string",
          "minLength": 1
        },
        "observationStrength": {
          "enum": ["exact", "substring", "presence", "ordering", "controlFlow", "other"]
        },
        "passingCounterexample": {
          "type": "string",
          "minLength": 1
        },
        "candidateRole": {
          "enum": ["observation", "fixtureSetup", "faultInjection", "cleanup"]
        },
        "candidateDisposition": {
          "enum": ["included"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "classification": { "enum": ["Documented", "Mixed"] },
              "observationStrength": { "enum": ["substring", "presence", "other"] }
            },
            "required": ["classification", "observationStrength"]
          },
          "then": {
            "required": ["passingCounterexample"]
          }
        },
        {
          "if": {
            "properties": {
              "classification": {
                "const": "Documented"
              }
            },
            "required": [
              "classification"
            ]
          },
          "then": {
            "required": ["decisiveClause", "observationStrength"],
            "properties": {
              "evidenceStatus": {
                "const": "Confirmed"
              },
              "citationHandles": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "classification": {
                "const": "Implicit"
              }
            },
            "required": [
              "classification"
            ]
          },
          "then": {
            "properties": {
              "evidenceStatus": {
                "const": "Ambiguous"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "classification": {
                "const": "Mixed"
              }
            },
            "required": [
              "classification"
            ]
          },
          "then": {
            "required": ["incidentalReason", "decisiveClause", "observationStrength"],
            "properties": {
              "evidenceStatus": {
                "const": "Confirmed"
              },
              "citationHandles": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "classification": {
                "const": "Incidental"
              }
            },
            "required": [
              "classification"
            ]
          },
          "then": {
            "required": [
              "incidentalReason"
            ]
          }
        }
      ]
    },
    "reuseRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assertionId",
        "reuseFrom",
        "equivalenceConfirmed",
        "citationHandles",
        "callingTestIds"
      ],
      "properties": {
        "assertionId": {
          "type": "string",
          "pattern": "^A[0-9]{6}$"
        },
        "reuseFrom": {
          "type": "string",
          "pattern": "^A[0-9]{6}$"
        },
        "equivalenceConfirmed": {
          "const": true
        },
        "citationHandles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^E[0-9a-f]{12}-[0-9]+$"
          }
        },
        "callingTestIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^T[0-9]{6}$"
          }
        },
        "unlinkedReason": {
          "type": "string",
          "minLength": 1
        },
        "unresolvedCallerReason": {
          "type": "string",
          "minLength": 1
        },
        "reviewReason": {
          "type": "string",
          "minLength": 1
        },
        "decisiveClause": {
          "type": "string",
          "minLength": 1
        },
        "observationStrength": {
          "enum": ["exact", "substring", "presence", "ordering", "controlFlow", "other"]
        },
        "passingCounterexample": {
          "type": "string",
          "minLength": 1
        },
        "candidateRole": {
          "enum": ["observation", "fixtureSetup", "faultInjection", "cleanup"]
        },
        "candidateDisposition": {
          "enum": ["included"]
        }
      }
    }
  }
}
